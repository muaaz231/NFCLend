# Copy this file to .env and fill in your own values. .env is git-ignored.

# Gmail account used to send checkout/return/reminder emails.
# Use a Google "App Password" (Google Account > Security > App passwords), not your normal password.
GMAIL_USER=your.sender@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# PostgreSQL connection
DB_NAME=nfcproject
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Used by nfc_mainVer3.py on the Raspberry Pi: public URL that reaches face_server.py (e.g. an ngrok tunnel to port 5001)
NFCLEND_SERVER=https://your-tunnel.ngrok-free.dev
